# This file will automatically update with entries for new content after a build and reload.
# Please read https://github.com/tModLoader/tModLoader/wiki/Localization to learn more about localization and these files.

Configs: {
	Toggle: {
		On: On
		Off: Off
	}

	CoreServerConfig: {
		DisplayName: Server Settings

		Modules: {
			Label: Modules
			Tooltip: Turn each module on or off. Hover a module to see what it does.
		}

		Admins: {
			Label: Admins
			Tooltip: Player names or player IDs that can run admin commands and change these settings in game. Names must match exactly. Players can see their ID with /smp whoami.
		}

		RosterMode: {
			Label: Roster mode
			Tooltip: Auto adds anyone who joins as a member. Manual only adds players an admin adds with /smp roster add.
		}

		InactiveDays: {
			Label: Inactive after (days)
			Tooltip: Members not seen for this many days stop counting toward the member total. 0 means never.
		}
	}

	RosterMode: {
		Auto: {
			Label: Auto
			Tooltip: ""
		}

		Manual: {
			Label: Manual
			Tooltip: ""
		}

		Tooltip: ""
	}

	UnknownBossPolicy: {
		Gate: {
			Label: Gate
			Tooltip: ""
		}

		Ignore: {
			Label: Ignore
			Tooltip: ""
		}

		Tooltip: ""
	}

	MidFightPolicy: {
		Continue: {
			Label: Continue
			Tooltip: ""
		}

		DespawnAfterWarning: {
			Label: Despawn after warning
			Tooltip: ""
		}

		Tooltip: ""
	}

	DiscordConfig: {
		DisplayName: Discord log

		PostJoinLeave: {
			Label: Post joins and leaves
			Tooltip: ""
		}

		PostChat: {
			Label: Post chat
			Tooltip: Public chat only. Party chat and commands are never posted.
		}

		PostDeaths: {
			Label: Post deaths
			Tooltip: ""
		}

		PostFirstBossKills: {
			Label: Post first boss kills
			Tooltip: Posts the first time this world beats each boss, with everyone who helped.
		}
	}

	RulesConfig: {
		DisplayName: Welcome and rules

		ShowWelcome: {
			Label: Show welcome message
			Tooltip: Send the welcome message to each player every time they join.
		}

		WelcomeMessage: {
			Label: Welcome message
			Tooltip: "{name} is replaced with the player's name and {world} with the world's name."
		}

		ShowRules: {
			Label: Show rules
			Tooltip: Show the rules to players the first time they join, and again whenever the rules change.
		}

		Rules: {
			Label: Rules
			Tooltip: One rule per line. They're numbered when shown.
		}

		RequireAccept: {
			Label: Must accept rules to build
			Tooltip: Players can't place or break blocks until they type /smp rules accept. The rules show on every join until they do, and again whenever the rules change.
		}
	}

	GatingConfig: {
		DisplayName: Gating

		ThresholdPercent: {
			Label: Threshold (%)
			Tooltip: Percent of members that must be online to fight a boss.
		}

		MinOnline: {
			Label: Minimum online
			Tooltip: Bosses stay locked with fewer than this many members online, whatever the percent says.
		}

		FirstKillOnly: {
			Label: First kill only
			Tooltip: Once a boss has been beaten it stays unlocked, so it can be farmed with any number of players.
		}

		Announce: {
			Label: Announce changes
			Tooltip: Server chat message when bosses lock or unlock, and when an admin locks or unlocks a boss.
		}

		UnknownBosses: {
			Label: Unknown bosses
			Tooltip: Modded bosses that neither Boss Checklist nor their own mod told Terraria Together about. Gate uses the shared threshold, Ignore lets them spawn freely.
		}

		MidFight: {
			Label: Mid-fight
			Tooltip: What happens when a boss becomes locked during its fight, e.g. someone leaves. Continue lets the fight finish. Despawn after warning gives the group time to get back online, then sends the boss away.
		}

		MidFightWarningSeconds: {
			Label: Mid-fight warning (seconds)
			Tooltip: How long a locked boss stays before leaving, when Mid-fight is Despawn after warning.
		}

		Headers: {
			Bosses: Bosses
			Debug: Debug
		}

		GatedBosses: {
			Label: Gated bosses
			Tooltip: Untick a boss to never lock it. /smp gating lock and unlock still win over this.
		}

		SimulatedOnline: {
			Label: Simulated online
			Tooltip: Pretend this many members are online, for testing thresholds solo. -1 turns it off.
		}

		SimulatedMembers: {
			Label: Simulated members
			Tooltip: Pretend the member total is this, for testing thresholds solo. -1 turns it off.
		}
	}
}

ModuleNames: {
	gating: Gating
	stats: Stats
	rules: Welcome and rules
	discord: Discord log
}

ModuleDescriptions: {
	gating: Keeps bosses and events locked until enough members are online. Settings are on the Gating page.
	stats: Tracks playtime, deaths, boss kills and PvP kills for each player. See them with /smp stats.
	rules: Greets players when they join and shows the server rules. Settings are on the Welcome and rules page.
	discord: Posts joins, leaves, chat, deaths and first boss kills to a Discord channel. Set it up with /smp discord url.
}

Discord: {
	Joined: **{0}** joined the server
	Left: **{0}** left the server
	Chat: **{0}**: {1}
	Death: "{0}"
	FirstKill: **{0}** defeated for the first time by {1}!

	Commands: {
		Usage: Usage: /smp discord [status | url <webhook url> | url clear]
		StatusSet: A Discord webhook is set. Use /smp discord url clear to remove it.
		StatusNotSet: No Discord webhook is set. Use /smp discord url <webhook url>.
		Set: Discord webhook saved, posts start now.
		Cleared: Discord webhook removed, nothing will be posted.
		Invalid: That isn't a Discord webhook URL. It should start with https://discord.com/api/webhooks/
	}
}

Rules: {
	Header: Server rules:
	Line: "  {0}. {1}"
	Changed: The server rules have changed.
	AcceptHint: Type /smp rules accept to agree to the rules. You can't build until you do.
	Accepted: Thanks for accepting the rules, you can build now.
	BuildBlocked: Accept the rules before building. Type /smp rules to read them.
	NoRules: This server has no rules set.
	ConsoleAccept: Only players can accept the rules.
	Usage: Usage: /smp rules [accept]
}

Stats: {
	Playtime: "{0}h {1}m"

	Commands: {
		Usage: Usage: /smp stats [player | top <playtime | deaths | bosses | pvp>]
		Header: Stats for {0}:
		Line: "  Playtime {0}, deaths {1}, bosses killed {2}, PvP kills {3}"
		TopHeader: Top {0}:
		TopLine: "  {0}. {1}: {2}"
		TopEmpty: "  Nobody has any yet."
		NotFound: No stats for a player named "{0}".
		Ambiguous: More than one player is named "{0}". Ask one of them to rename and rejoin.
		NoUuid: Your stats aren't ready yet, try again in a moment.

		Boards: {
			playtime: playtime
			deaths: deaths
			bosses: boss kills
			pvp: PvP kills
		}
	}
}

Gating: {
	Locked: "{0} is locked: {1}/{2} online (need {3})."
	LockedByAdmin: "{0} is locked by an admin."

	Tooltip: {
		Locked: Locked: {0}/{1} online (need {2})
		LockedByAdmin: Locked by an admin
		Unlocked: Unlocked
	}

	Announce: {
		ThresholdUnlocked: Bosses are now unlocked: {0}/{1} members online (need {2}).
		ThresholdRelocked: Bosses are locked again: {0}/{1} members online (need {2}).

		Override: {
			Unlocked: "{0} was unlocked by an admin."
			Locked: "{0} was locked by an admin."
			None: "{0} is back to normal rules."
		}
	}

	Commands: {
		Usage: Usage: /smp gating [status | lock <boss> | unlock <boss> | clear <boss>]
		StatusHeader: "{0}/{1} members online, {2} needed. First kill only: {3}."
		StatusLocked: "  {0}: locked"
		StatusUnlocked: "  {0}: unlocked"
		StatusDowned: "  {0}: unlocked (already beaten)"
		StatusNotGated: "  {0}: unlocked (not gated in config)"
		StatusForcedUnlock: "  {0}: unlocked by an admin"
		StatusForcedLock: "  {0}: locked by an admin"
		BossNotFound: No boss called "{0}". Use /smp gating status to see the names.
		BossAmbiguous: More than one boss matches "{0}". Use the full key, like Terraria/EyeOfCthulhu.
	}

	EventsHeading: "{0} events"

	MidFight: {
		Warning: "{0} is locked: {1}/{2} online (need {3}). It will leave in {4} seconds unless enough members come online."
		Stays: Enough members are online again, {0} stays.
		Left: "{0} left because not enough members were online."
	}

	Bosses: {
		KingSlime: King Slime
		EyeOfCthulhu: Eye of Cthulhu
		EaterOfWorlds: Eater of Worlds
		BrainOfCthulhu: Brain of Cthulhu
		QueenBee: Queen Bee
		Skeletron: Skeletron
		Deerclops: Deerclops
		WallOfFlesh: Wall of Flesh
		QueenSlime: Queen Slime
		TheTwins: The Twins
		TheDestroyer: The Destroyer
		SkeletronPrime: Skeletron Prime
		Plantera: Plantera
		Golem: Golem
		DukeFishron: Duke Fishron
		EmpressOfLight: Empress of Light
		LunaticCultist: Lunatic Cultist
		MoonLord: Moon Lord
		GoblinArmy: Goblin Army
		FrostLegion: Frost Legion
		Pirates: Pirate Invasion
		MartianMadness: Martian Madness
		PumpkinMoon: Pumpkin Moon
		FrostMoon: Frost Moon
		OldOnesArmy: Old One's Army
	}
}

Commands: {
	Description: Terraria Together commands. Use /smp help.
	Help:
		'''
		/smp help - show this list
		/smp modules - list modules and whether they're on
		/smp whoami - show your name, ID and admin status
		/smp roster - list members and who's online
		/smp gating - show which bosses are locked
		/smp rules - show the server rules, /smp rules accept to agree to them
		/smp stats [player] - playtime, deaths and kills
		/smp stats top [playtime|deaths|bosses|pvp] - top 5 players
		'''
	HelpAdmin:
		'''
		Admin commands:
		/smp roster add|remove|exclude <name> - manage members
		/smp gating lock|unlock|clear <boss> - override a boss's lock
		/smp discord - check whether a Discord webhook is set
		/smp discord url <url>|clear - set or remove the Discord webhook
		'''
	Unknown: Unknown command "{0}". Use /smp help.
	NotAdmin: Only server admins can do that.
	NoModules: No modules are installed yet.
	ModulesHeader: Modules:
	ModuleLine: "  {0}: {1}"
	On: on
	Off: off
	ModuleDisabled: The {0} module is turned off.
	NoModuleCommands: The {0} module has no commands.

	WhoAmI: {
		Console: You are the server console, which is always an admin.
		Admin: "{0} (ID {1}): admin"
		Player: "{0} (ID {1}): not an admin"
		UnknownUuid: not received yet
	}

	Roster: {
		Usage: Usage: /smp roster [list | add <name> | remove <name> | exclude <name>]
		Empty: No members yet.
		Header: "{0} of {1} members online:"
		LineOnline: "  {0}: online"
		LineOffline: "  {0}: last seen {1} days ago"
		LineInactive: "  {0}: inactive, last seen {1} days ago"
		LineExcluded: "  {0}: excluded"
		Added: "{0} is now a member."
		Removed: "{0} was removed from the roster. In Auto mode they'll be added again next time they join, use exclude to keep them out of the counts."
		Excluded: "{0} is now excluded and won't count toward online or total. Run exclude again to undo."
		Included: "{0} counts toward online and total again."
		AlreadyMember: "{0} is already a member."
		NotOnline: No online player is named "{0}". Players have to be online to be added.
		NoUuid: "{0} hasn't finished joining yet, try again in a moment."
		NotFound: No member is named "{0}".
		Ambiguous: More than one member is named "{0}". Ask one of them to rename and rejoin.
	}
}
